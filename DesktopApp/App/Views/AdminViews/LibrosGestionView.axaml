<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800"
             d:DesignHeight="450"
             xmlns:vm="using:App.ViewModels.AdminViewModels"
             xmlns:conv="using:App.utils"
             x:DataType="vm:LibrosGestionViewModel"
             x:Class="App.Views.AdminViews.LibrosGestionView">
    <UserControl.Resources>
        <conv:UrlToBitmapConverter x:Key="UrlToBitmapConv"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto, *" Margin="25">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
            <TextBox Grid.Column="0"
                     Text="{Binding TextoBusqueda, Mode=TwoWay}"
                     PlaceholderText="Buscar libros por título, autor o categoría..."
                     Height="42" CornerRadius="6" Background="#120F1A" BorderBrush="#2A2238" BorderThickness="1" Foreground="#FFFFFF" VerticalContentAlignment="Center">
                <TextBox.InnerLeftContent>
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="#6F6C7D"/>
                </TextBox.InnerLeftContent>
            </TextBox>
            <Button Grid.Column="1" Command="{Binding BuscarLibroCommand}" Content="Buscar" Height="42" Width="100" Margin="10,0,0,0" CornerRadius="6" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="#FFFFFF" FontWeight="Medium">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0.0" Color="#512BD4"/>
                        <GradientStop Offset="1.0" Color="#7022B4"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*, 320" Margin="0,5,0,0">

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,15,0">
                <ListBox ItemsSource="{Binding Libros}"
                         SelectedItem="{Binding LibroSeleccionado, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="170" Height="285"
                                    Background="#120F1A"
                                    BorderBrush="#2A2238"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="6"
                                    Padding="12">
                                <Grid RowDefinitions="140, Auto, Auto, *">

                                    <Border Grid.Row="0" CornerRadius="6" ClipToBounds="True" Background="#07050A" Margin="0,0,0,8">
                                        <Panel>
                                            <TextBlock Text="📖" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.15"/>
                                            <Image Source="{Binding ImagenUrl, Converter={StaticResource UrlToBitmapConv}}"
                                                   Stretch="UniformToFill"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        </Panel>
                                    </Border>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Titulo}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="2"/>

                                    <TextBlock Grid.Row="2"
                                               Text="{Binding Autor}"
                                               FontSize="11"
                                               Foreground="#9A95B0"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"/>

                                    <Grid Grid.Row="3" VerticalAlignment="Bottom" ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                                        <Border Grid.Column="0" Background="#2A2238" Padding="6,3" CornerRadius="4" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Categoria}"
                                                       FontSize="10"
                                                       Foreground="#A370F7"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="85"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="🟢" FontSize="7" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Disponible}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="/" FontSize="11" Foreground="#6F6C7D"/>
                                            <TextBlock Text="{Binding Stock}" FontSize="11" Foreground="#9A95B0"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <Border Grid.Column="1" Background="#07050A" BorderBrush="#2A2238" BorderThickness="1" CornerRadius="8" Padding="15">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <TextBlock Text="Gestión de Libro" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,5"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Título del Libro" FontSize="11" Foreground="#9A95B0"/>
                            <TextBox Text="{Binding TituloFormulario, Mode=TwoWay}" Height="36" Background="#120F1A" BorderBrush="#2A2238" CornerRadius="4"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Autor" FontSize="11" Foreground="#9A95B0"/>
                            <TextBox Text="{Binding AutorFormulario, Mode=TwoWay}" Height="36" Background="#120F1A" BorderBrush="#2A2238" CornerRadius="4"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Categoría" FontSize="11" Foreground="#9A95B0"/>
                            <TextBox Text="{Binding CategoriaFormulario, Mode=TwoWay}" Height="36" Background="#120F1A" BorderBrush="#2A2238" CornerRadius="4"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,5,0">
                                <TextBlock Text="Stock Total" FontSize="11" Foreground="#9A95B0"/>
                                <TextBox Text="{Binding StockFormulario, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="36" Background="#120F1A" BorderBrush="#2A2238" CornerRadius="4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="5,0,0,0">
                                <TextBlock Text="Disponibles (Calculado)" FontSize="11" Foreground="#A370F7"/>
                                <TextBox Text="{Binding DisponibleFormulario, Mode=OneWay}" IsReadOnly="True" Opacity="0.6" Height="36" Background="#07050A" BorderBrush="#2A2238" CornerRadius="4"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4" Margin="0,4,0,4">
                            <TextBlock Text="Portada del Libro" FontSize="11" Foreground="#9A95B0"/>
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding NombreArchivoImagen, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Height="36"
                                         Background="#120F1A"
                                         BorderBrush="#2A2238"
                                         CornerRadius="4,0,0,4"
                                         FontSize="11"
                                         VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Command="{Binding SeleccionarImagenCommand}"
                                        Content="Subir 🖼️"
                                        Height="36"
                                        CornerRadius="0,4,4,0"
                                        Background="#2A2238"
                                        Foreground="White"
                                        BorderBrush="#2A2238"
                                        VerticalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="{Binding MensajeFormulario}" Foreground="#A370F7" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,5"/>

                        <Button Command="{Binding GuardarLibroCommand}" Content="Guardar Cambios" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="38" CornerRadius="4" Foreground="White" FontWeight="Medium">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Offset="0.0" Color="#512BD4"/>
                                    <GradientStop Offset="1.0" Color="#7022B4"/>
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>

                        <Button x:Name="BotonEliminar"
                                Content="Eliminar Libro 🗑️"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Height="36"
                                CornerRadius="4"
                                Background="#4A1525"
                                BorderBrush="#8B263E"
                                BorderThickness="1"
                                Foreground="#FF85A1"
                                Margin="0,8,0,0"
                                IsEnabled="{Binding EsEdicion}">
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <Border Background="#120F1A" BorderBrush="#2A2238" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                                            <TextBlock Text="¿Seguro que deseas eliminar este libro?"
                                                       Foreground="#FFFFFF"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                            <Button Command="{Binding EliminarLibroCommand}"
                                                    Content="Sí, eliminar definitivamente"
                                                    Background="#8B263E"
                                                    Foreground="White"
                                                    FontSize="11"
                                                    Padding="12,6"
                                                    CornerRadius="4"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"/>
                                            <TextBlock Text="(Haz clic fuera para cancelar)"
                                                       Foreground="#6F6C7D"
                                                       FontSize="10"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>

</UserControl>
