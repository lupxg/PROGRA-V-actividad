<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             
             x:Class="App.Views.AdminViews.PedidosAdminView">
<Grid ColumnDefinitions="*, 340" Margin="25">
        
        <Grid Grid.Column="0" RowDefinitions="Auto, *" Margin="0,0,15,0">
            
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                <TextBox Grid.Column="0"
                         PlaceholderText="Buscar por usuario, libro o estado (Pendiente, Entregado)..."
                         Height="42" CornerRadius="6" Background="#120F1A" BorderBrush="#2A2238" BorderThickness="1" Foreground="#FFFFFF" VerticalContentAlignment="Center">
                    <TextBox.InnerLeftContent>
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="#6F6C7D"/>
                    </TextBox.InnerLeftContent>
                </TextBox>
                <Button Grid.Column="1" Content="Buscar" Height="42" Width="100" Margin="10,0,0,0" CornerRadius="6" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="#FFFFFF" FontWeight="Medium">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Offset="0.0" Color="#512BD4"/>
                            <GradientStop Offset="1.0" Color="#7022B4"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ListBox Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#120F1A" BorderBrush="#2A2238" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="15">
                                <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                    
                                    <TextBlock Grid.Column="0" Text="📦" FontSize="22" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="Guillermo Chávez" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Libro: Fenomenología del espíritu" FontSize="12" Foreground="#9A95B0"/>
                                        <TextBlock Text="Fecha Solicitud: 01/06/2026" FontSize="11" Foreground="#6F6C7D"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="#2A1A30" Padding="8,4" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,15,0">
                                        <TextBlock Text="Pendiente" FontSize="11" Foreground="#A370F7" FontWeight="SemiBold"/>
                                    </Border>

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="Cant: 1" FontSize="12" Foreground="#FFFFFF" FontWeight="Medium"/>
                                    </StackPanel>
                                    
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="1" Background="#07050A" BorderBrush="#2A2238" BorderThickness="1" CornerRadius="8" Padding="15">
            <ScrollViewer>
                <StackPanel Spacing="12">
                    <TextBlock Text="Gestión de Pedido" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,5"/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="ID Pedido" FontSize="11" Foreground="#9A95B0"/>
                        <TextBox IsReadOnly="True" Opacity="0.5" Text="Nuevo Pedido (Auto)" Height="36" Background="#120F1A" BorderBrush="#2A2238" CornerRadius="4"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="ID o Nombre de Usuario" FontSize="11" Foreground="#9A95B0"/>
                        <TextBox PlaceholderText="Ej: 42 o Guillermo Chávez" Height="36" Background="#120F1A" BorderBrush="#2A2238" CornerRadius="4"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="ID o Título del Libro" FontSize="11" Foreground="#9A95B0"/>
                        <TextBox PlaceholderText="Ej: 10 o Fenomenología del espíritu" Height="36" Background="#120F1A" BorderBrush="#2A2238" CornerRadius="4"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Cantidad Solicitada" FontSize="11" Foreground="#9A95B0"/>
                        <TextBox Text="1" Height="36" Background="#120F1A" BorderBrush="#2A2238" CornerRadius="4"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Estado del Pedido" FontSize="11" Foreground="#9A95B0"/>
                        <ComboBox HorizontalAlignment="Stretch" Height="36" Background="#120F1A" BorderBrush="#2A2238" CornerRadius="4">
                            <ComboBoxItem Content="Pendiente"/>
                            <ComboBoxItem Content="Entregado"/>
                            <ComboBoxItem Content="Rechazado"/>
                            <ComboBoxItem Content="Devuelto"/>
                        </ComboBox>
                    </StackPanel>

                    <TextBlock Text="" Foreground="#A370F7" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,5"/>

                    <Button Content="Guardar Pedido" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="38" CornerRadius="4" Foreground="White" FontWeight="Medium">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0.0" Color="#512BD4"/>
                                <GradientStop Offset="1.0" Color="#7022B4"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <Button Content="Eliminar Pedido 🗑️"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Height="36"
                            CornerRadius="4"
                            Background="#4A1525"
                            BorderBrush="#8B263E"
                            BorderThickness="1"
                            Foreground="#FF85A1"
                            Margin="0,8,0,0">
                    </Button>
                    
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
