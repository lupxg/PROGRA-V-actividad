<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:App.ViewModels"
             x:DataType="vm:LectorViewModel"
             x:Class="App.Views.LectorView">

    <Grid ColumnDefinitions="240, *">
        <Border Grid.Column="0" BorderBrush="#2A2238" BorderThickness="0,0,1,0" Background="#07050A">
            <Grid RowDefinitions="Auto, *, Auto" Margin="20">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,10,0,30">
                    <TextBlock Text="BiblioNet" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="8">
                    <Button Classes="MenuButton Active" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="📚"/> <TextBlock Text="Libros Disponibles"/></StackPanel>
                    </Button>
                    <Button Classes="MenuButton" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="⏱️"/> <TextBlock Text="Mis Pedidos"/></StackPanel>
                    </Button>
                    <Button Classes="MenuButton" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="⚠️"/> <TextBlock Text="Mis Multas (0)"/></StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="2" BorderBrush="#2A2238" BorderThickness="0,1,0,0" Padding="0,15,0,0">
                    <DockPanel>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Usuario Lector" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Lector" FontSize="11" Foreground="#6F6C7D"/>
                        </StackPanel>
                        <Button Content="🚪" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto, Auto, *" Margin="30">
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,25">
                <TextBox Grid.Column="0" PlaceholderText="Buscar por título, autor o género..." Height="42" CornerRadius="6" Background="#120F1A" BorderBrush="#2A2238" BorderThickness="1" Foreground="#FFFFFF" VerticalContentAlignment="Center">
                    <TextBox.InnerLeftContent>
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="#6F6C7D"/>
                    </TextBox.InnerLeftContent>
                </TextBox>
                <Button Grid.Column="1" Content="Buscar" Height="42" Width="100" Margin="10,0,0,0" CornerRadius="6" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="#FFFFFF" FontWeight="Medium">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Offset="0.0" Color="#512BD4"/>
                            <GradientStop Offset="1.0" Color="#7022B4"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </Grid>

            <TextBlock Grid.Row="1" Text="Libros Disponibles" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,15"/>

            <ScrollViewer Grid.Row="2">
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Border Width="210" Height="310" Background="#120F1A" BorderBrush="#2A2238" BorderThickness="1" CornerRadius="8" Margin="0,0,16,16" Padding="12">
                        <Grid RowDefinitions="*, Auto, Auto, Auto">
                            <Border Grid.Row="0" Background="#1D192B" CornerRadius="4" Margin="0,0,0,10">
                                <TextBlock Text="📖" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Clean Code" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="2" Text="Robert C. Martin" FontSize="11" Foreground="#9A95B0" Margin="0,2,0,10"/>
                            <Button Grid.Row="3" Content="Solicitar Préstamo" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="4" Background="Transparent" BorderBrush="#A370F7" BorderThickness="1" Foreground="#A370F7" FontSize="12" Padding="5">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#512BD4"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="BorderBrush" Value="#512BD4"/>
                                    </Style>
                                </Button.Styles>
                            </Button>
                        </Grid>
                    </Border>
                </WrapPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
